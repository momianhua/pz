PORT=6217
HOST=localhost
GATEWAY_API_KEY=
AGENT_ENGINE=opencode

# mock: both engines run locally without credentials; real: use actual adapters
ENGINE_MODE=mock

PI_COMMAND=pi
# 调试可使用任意可用模型；GLM5.2 仅为比赛推荐配置
PI_PROVIDER=replace-with-provider-id
PI_MODEL=replace-with-model-id
PI_SESSION_ROOT=./data/pi-sessions

OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_DIRECTORY=.
OPENCODE_PROVIDER_ID=replace-with-provider-id
OPENCODE_MODEL_ID=replace-with-model-id

STATE_FILE=./data/state.json
MAX_BODY_BYTES=1048576
RUN_TIMEOUT_MS=120000
