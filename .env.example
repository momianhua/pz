PORT=6217
HOST=localhost
GATEWAY_API_KEY=
AGENT_ENGINE=opencode

# Optional unified OpenAI-compatible local model configuration.
# When LOCAL_MODEL_BASE_URL is set, the gateway generates Pi/OpenCode runtime
# configuration inside ./data and no user-home configuration is required.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_PROVIDER_ID=local-openai
LOCAL_MODEL_ID=deepseek
LOCAL_MODEL_API_KEY=local
# 可选：自定义鉴权头。AUTH_VALUE 留空时复用 LOCAL_MODEL_API_KEY
LOCAL_MODEL_AUTH_HEADER=
LOCAL_MODEL_AUTH_VALUE=
LOCAL_MODEL_CONTEXT_WINDOW=32768
LOCAL_MODEL_MAX_TOKENS=8192

# mock: both engines run locally without credentials; real: use actual adapters
ENGINE_MODE=mock

PI_COMMAND=pi
# Leave provider/model empty to inherit LOCAL_MODEL_PROVIDER_ID/LOCAL_MODEL_ID.
PI_PROVIDER=
PI_MODEL=
PI_SESSION_ROOT=./data/pi-sessions
PI_AGENT_DIR=./data/runtime/pi-agent
# Windows defaults to powershell.exe so Pi can execute tools without Git Bash.
PI_SHELL_PATH=

OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_COMMAND=opencode
OPENCODE_AUTOSTART=true
# allow: unattended runs; ask: require approval for every tool including read; deny: block tools
OPENCODE_PERMISSION_MODE=allow
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_DIRECTORY=.
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL_ID=

STATE_FILE=./data/state.json
MAX_BODY_BYTES=1048576
RUN_TIMEOUT_MS=600000
